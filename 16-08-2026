    <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Smooth Scrolling */
        html { scroll-behavior: smooth; }

        body { 
            font-family: Calibri, 'Segoe UI', sans-serif; 
            margin: 0; 
            background-color: #f0f2f5; 
            color: #333;
            line-height: 1.6;
        }
        
        header { 
            background-color: #1a252f; 
            color: white; 
            padding: 20px; 
            text-align: center; 
            position: relative; 
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            border-bottom: 4px solid #e74c3c;
        }
        
        .gs-logo { margin: 0; font-size: 2.5rem; font-family: 'Kalam', cursive; color: #f1c40f; text-shadow: 1px 1px 2px #000; }
        header p { margin: 5px 0 0; color: #ecf0f1; font-size: 1.1rem; }

        .container { 
            max-width: 800px; 
            margin: 50px auto; 
            padding: 0 20px; 
            min-height: 50vh;
        }

        /* Notice Box Styles */
        .notice-box {
            background: white;
            border-radius: 12px;
            padding: 40px 30px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            border-top: 6px solid #e74c3c;
            text-align: center;
        }
        
        .notice-box i.main-icon { 
            font-size: 4rem; 
            color: #e74c3c; 
            margin-bottom: 20px; 
        }
        
        .notice-title { 
            font-size: 2.2rem; 
            color: #2c3e50; 
            margin-top: 0; 
            margin-bottom: 15px; 
            font-weight: bold; 
        }
        
        .notice-text { 
            font-size: 1.25rem; 
            color: #555; 
            margin-bottom: 30px; 
        }

        /* Agenda Box Styles */
        .agenda-box {
            background: #fdfae6;
            border: 2px dashed #f39c12;
            padding: 25px;
            text-align: left;
            border-radius: 10px;
            color: #2c3e50;
            margin: 0 auto;
            max-width: 600px;
            font-size: 1.15rem;
        }
        
        .agenda-box h3 { 
            color: #d35400; 
            margin-top: 0; 
            text-align: center; 
            font-size: 1.5rem; 
            border-bottom: 1px solid #f1c40f;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }
        
        .agenda-list { 
            list-style-type: none; 
            padding: 0; 
            margin: 0; 
        }
        
        .agenda-list li { 
            margin-bottom: 12px; 
            padding-left: 30px; 
            position: relative; 
            font-weight: bold;
        }
        
        .agenda-list li::before { 
            content: '\f138'; 
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute; 
            left: 0; 
            color: #e67e22; 
        }

        .closing-text { 
            font-size: 1.5rem; 
            color: #27ae60; 
            font-weight: bold; 
            margin-top: 35px; 
            font-family: 'Kalam', cursive;
        }

        /* Footer Styles */
        footer { 
            text-align: center; 
            padding: 25px; 
            background: #1a252f; 
            color: white; 
            margin-top: 40px; 
            border-top: 5px solid #f1c40f; 
        }
        .social-links { 
            display: flex; 
            justify-content: center; 
            flex-wrap: wrap; 
            gap: 20px; 
            margin-top: 15px; 
        }
        .social-links a { 
            color: white; 
            text-decoration: none; 
            font-size: 1.2rem; 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            transition: 0.3s; 
        }
        .social-links a:hover { color: #f1c40f; }

